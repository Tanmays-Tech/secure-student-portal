<%@ page contentType="text/html;charset=UTF-8" %><!DOCTYPE html><html><head><title>Login</title><link rel="stylesheet" href="style.css"></head><body><main class="card"><h1>Secure Student Portal</h1><h2>Login</h2><% if(request.getAttribute("error")!=null){ %><p class="error"><%=request.getAttribute("error")%></p><% } %><% if(request.getParameter("registered")!=null){ %><p class="success">Account created. Please login.</p><% } %><form method="post" action="login"><input type="hidden" name="csrf" value="<%=request.getAttribute("csrf")%>"><label>Username</label><input name="username" required maxlength="40"><label>Password</label><input name="password" type="password" required maxlength="72"><button>Login</button></form><p>New user? <a href="register">Register</a></p></main></body></html>